  m_Script: {fileID: 11500000, guid: 9323c964033142da8f6195d7ab13d981, type: 3}
  m_Name: Brains or a Heart
  m_EditorClassIdentifier: PebblePouch.Lore.Samples.OzDemo::PebblePouch.Lore.Samples.OzDemo.OzDialogue
  _lines:
  - _speaker: Scarecrow
    _text: I shall ask for brains instead of a heart; for a fool would not know what
      to do with a heart if he had one.
  - _speaker: Tin Woodman
    _text: I shall take the heart; for brains do not make one happy, and happiness
      is the best thing in the world.
