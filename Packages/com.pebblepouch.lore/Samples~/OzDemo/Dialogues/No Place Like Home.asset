  m_Script: {fileID: 11500000, guid: 9323c964033142da8f6195d7ab13d981, type: 3}
  m_Name: No Place Like Home
  m_EditorClassIdentifier: PebblePouch.Lore.Samples.OzDemo::PebblePouch.Lore.Samples.OzDemo.OzDialogue
  _lines:
  - _speaker: Scarecrow
    _text: I cannot understand why you should wish to leave this beautiful country
      and go back to the dry, gray place you call Kansas.
  - _speaker: Dorothy
    _text: That is because you have no brains.
  - _speaker: Dorothy
    _text: No matter how dreary and gray our homes are, we people of flesh and blood
      would rather live there than in any other country, be it ever so beautiful.
      There is no place like home.
