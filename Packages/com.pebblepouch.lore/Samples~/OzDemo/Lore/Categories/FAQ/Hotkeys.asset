  m_Name: Hotkeys
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: a9fa1649-1161-4bac-8a9a-f229d8f93cd1
  _createdTicks: 639304141583617109
