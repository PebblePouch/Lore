  m_Name: Queen of the Field Mice
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: ff9df0b3-e5a4-465b-a23d-046f33812363
  _createdTicks: 639304141573694337
  _modifiedTicks: 639304141632276278
  _category: {fileID: 11400000, guid: 8b7b72a809a05de42b9e4e1a9fc3d116, type: 2}
  _glyph: "\U0001F42D\uFE0F"
  _subtitle: Saved from a wildcat
  _description: The [[2068ec5f-e108-487b-a58a-19fa835fb595|Tin Woodman]] saves her
    from a wildcat. In return her mice pull the sleeping [[1f3bde9e-b7b4-4f25-84b5-bb07bc7708e2|Cowardly
    Lion]] out of the [[62922082-a360-4023-8d2f-0a4761d2d265|Deadly Poppy Field]]
    on a little wooden truck.
