  m_Script: {fileID: 11500000, guid: 9a0bde6d39cdc9a42a0ea995681e320e, type: 3}
  m_Name: Dorothy Gale
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: 74be2f99-978f-4a21-9eca-fc675e81362d
  _createdTicks: 639272563454472327
  _modifiedTicks: 639272563511155314
  _category: {fileID: 11400000, guid: 8b7b72a809a05de42b9e4e1a9fc3d116, type: 2}
  _glyph: "\U0001F467\uFE0F"
  _subtitle: A little girl from Kansas
  _description: 'Lives on the gray Kansas prairie with [[2787076c-3066-482e-954b-f04d871021a5|Aunt
    Em]], [[faf14613-c12b-42df-b169-e945952f6f69|Uncle Henry]] and her dog [[96ad4c10-f5e2-4a6c-8d22-26d10fc4d14f|Toto]].
    A cyclone carries her house into the land of the Munchkins, where it falls on
    the [[35199687-7412-4596-9c07-e7916de182a9|Wicked Witch of the East]]. To find
    her way home she follows the [[22517d6a-af9c-4981-8a3e-d8094cd6507c|Yellow Brick
    Road]] to the [[81773492-1f02-4ad4-9a99-9d831db56088|Emerald City]].


    *The
    player character.*'
