  m_Name: Wicked Witch of the West
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: be9e56ee-6d1f-425c-bb06-5f87fd88d22e
  _createdTicks: 639304141572615935
  _modifiedTicks: 639304141632276278
  _category: {fileID: 11400000, guid: 8b7b72a809a05de42b9e4e1a9fc3d116, type: 2}
  _glyph: "\U0001F9B9\uFE0F"
  _subtitle: Tyrant of the Winkies
  _description: Has only one eye, but it is as powerful as a telescope. She enslaves
    the Winkies and commands the [[066faba0-3e5b-46be-8aa8-c13ba35d33d3|King of the
    Winged Monkeys]] with the [[f49fc573-16e3-4e9f-af2f-0765f661f274|Golden Cap]].
    Water is the **only** thing she fears, apart from the dark.
  _sortOrder: 7
