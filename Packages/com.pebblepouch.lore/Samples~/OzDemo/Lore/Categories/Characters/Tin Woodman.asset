  m_Name: Tin Woodman
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: 5fa1b2c9-d6af-4624-a28a-bb96064706e6
  _createdTicks: 639272563455236339
  _modifiedTicks: 639272563511155314
  _category: {fileID: 11400000, guid: 8b7b72a809a05de42b9e4e1a9fc3d116, type: 2}
  _glyph: "\U0001FA93\uFE0F"
  _subtitle: Hopes for a heart
  _description: Once a Munchkin woodman. An enchanted axe cut him piece by piece,
    and a tinsmith replaced every part with tin, but no one could give him back his
    heart. Found rusted stiff in the [[5f1c8c7f-e38d-43c7-9e1f-218f4d2a3b6f|Tin Woodman's
    Forest]]; he never goes anywhere without his [[14fd2a42-6ab1-4560-92a8-abcf93f4a252|Oil
    Can]]. Later he rules the Winkies.
  _sortOrder: 3
