  m_Name: Scarecrow
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: ee41e80d-2956-479b-b6eb-dc5abc1ac98a
  _createdTicks: 639304141571299688
