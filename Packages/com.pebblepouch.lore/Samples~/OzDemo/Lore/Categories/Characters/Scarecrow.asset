  m_Name: Scarecrow
  m_EditorClassIdentifier: PebblePouch.Lore::PebblePouch.Lore.Entry
  _id: 758f6dde-27cb-482c-9255-91e3e88dc13c
  _createdTicks: 639273194265910279
